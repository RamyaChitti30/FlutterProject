
import 'package:flutter/material.dart';

void main() => runApp(const WildlifeApp());

class WildlifeApp extends StatelessWidget {
  const WildlifeApp({super.key});

  @override
  Widget build(BuildContext context) => MaterialApp(
    debugShowCheckedModeBanner: false,
    theme: ThemeData(
      colorSchemeSeed: Colors.green,
      useMaterial3: true,
    ),
    home: const WildlifePage(),
  );
}

class WildlifePage extends StatefulWidget {
  const WildlifePage({super.key});

  @override
  State<WildlifePage> createState() => _WildlifePageState();
}

class _WildlifePageState extends State<WildlifePage>
    with SingleTickerProviderStateMixin {

  late AnimationController controller;

  final animals = [
    ['Lion', 'King of the Jungle', '🦁', 'Lions live in groups called prides.'],
    ['Elephant', 'Largest Land Animal', '🐘', 'Elephants have excellent memory.'],
    ['Tiger', 'Powerful Wild Cat', '🐅', 'Tigers have unique stripe patterns.'],
    ['Giraffe', 'Tallest Land Animal', '🦒', 'Giraffes have very long necks.'],
    ['Panda', 'Bamboo Lover', '🐼', 'Giant pandas mainly eat bamboo.'],
    ['Deer', 'Forest Animal', '🦌', 'Deer are known for their speed.'],
    ['Monkey', 'Smart Primate', '🐒', 'Monkeys are intelligent and social.'],
    ['Fox', 'Clever Animal', '🦊', 'Foxes have excellent hearing.'],
    ['Wolf', 'Pack Hunter', '🐺', 'Wolves live and hunt in packs.'],
    ['Bear', 'Strong Mammal', '🐻', 'Bears have a strong sense of smell.'],
    ['Zebra', 'Striped Animal', '🦓', 'Every zebra has a unique stripe pattern.'],
    ['Kangaroo', 'Australian Animal', '🦘', 'Kangaroos move by hopping.'],
    ['Crocodile', 'Reptile', '🐊', 'Crocodiles are excellent swimmers.'],
    ['Eagle', 'Powerful Bird', '🦅', 'Eagles have sharp eyesight.'],
    ['Owl', 'Night Bird', '🦉', 'Owls are active mostly at night.'],
    ['Peacock', 'Beautiful Bird', '🦚', 'Peacocks display colorful tail feathers.'],
    ['Dolphin', 'Marine Mammal', '🐬', 'Dolphins communicate using sounds.'],
    ['Shark', 'Ocean Predator', '🦈', 'Sharks have multiple rows of teeth.'],
    ['Penguin', 'Flightless Bird', '🐧', 'Penguins are excellent swimmers.'],
    ['Turtle', 'Long-lived Reptile', '🐢', 'Turtles have protective shells.'],
  ];

  @override
  void initState() {
    super.initState();

    controller = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 3),
    )..forward();
  }

  @override
  void dispose() {
    controller.dispose();
    super.dispose();
  }

  void showAnimal(int index) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: Text(
          '${animals[index][2]} ${animals[index][0]}',
        ),
        content: Text(
          '${animals[index][1]}\n\n${animals[index][3]}',
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Close'),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) => Scaffold(
    appBar: AppBar(
      title: const Text(
        'Wildlife Gallery 🐾',
        style: TextStyle(fontWeight: FontWeight.bold),
      ),
      backgroundColor: Colors.green.shade700,
      foregroundColor: Colors.white,
      centerTitle: true,
    ),

    body: Column(
      children: [
        Container(
          width: double.infinity,
          padding: const EdgeInsets.all(18),
          color: Colors.green.shade50,
          child: const Column(
            children: [
              Text(
                'Explore the Animal Kingdom',
                style: TextStyle(
                  fontSize: 22,
                  fontWeight: FontWeight.bold,
                  color: Colors.green,
                ),
              ),
              SizedBox(height: 5),
              Text('Discover amazing wildlife around the world!'),
            ],
          ),
        ),

        Expanded(
          child: GridView.builder(
            padding: const EdgeInsets.all(14),
            itemCount: animals.length,

            gridDelegate:
                const SliverGridDelegateWithFixedCrossAxisCount(
              crossAxisCount: 2,
              crossAxisSpacing: 12,
              mainAxisSpacing: 12,
              childAspectRatio: 0.82,
            ),

            itemBuilder: (context, index) {
              final start = (index * 0.035).clamp(0.0, 0.65);

              final animation = CurvedAnimation(
                parent: controller,
                curve: Interval(
                  start,
                  1.0,
                  curve: Curves.easeOutBack,
                ),
              );

              return AnimatedBuilder(
                animation: animation,

                builder: (context, child) => Transform.translate(
                  offset: Offset(
                    0,
                    80 * (1 - animation.value),
                  ),
                  child: Opacity(
                    opacity: animation.value.clamp(0.0, 1.0),
                    child: child,
                  ),
                ),

                child: GestureDetector(
                  onTap: () => showAnimal(index),

                  child: Card(
                    elevation: 5,
                    color: Colors.green.shade50,
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(18),
                    ),

                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Text(
                          animals[index][2],
                          style: const TextStyle(fontSize: 58),
                        ),

                        const SizedBox(height: 10),

                        Text(
                          animals[index][0],
                          style: const TextStyle(
                            fontSize: 19,
                            fontWeight: FontWeight.bold,
                            color: Colors.green,
                          ),
                        ),

                        const SizedBox(height: 5),

                        Padding(
                          padding: const EdgeInsets.symmetric(
                            horizontal: 5,
                          ),
                          child: Text(
                            animals[index][1],
                            textAlign: TextAlign.center,
                            style: const TextStyle(fontSize: 12),
                          ),
                        ),

                        const SizedBox(height: 8),

                        const Text(
                          'Tap to know more',
                          style: TextStyle(
                            fontSize: 10,
                            color: Colors.blueGrey,
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              );
            },
          ),
        ),
      ],
    ),

    floatingActionButton: FloatingActionButton(
      backgroundColor: Colors.green,
      foregroundColor: Colors.white,
      onPressed: () {
        controller.reset();
        controller.forward();
      },
      child: const Icon(Icons.refresh),
    ),
  );
}
